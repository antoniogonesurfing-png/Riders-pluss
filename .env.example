# Copy to .env (or set in your host's dashboard). Nothing here is required for local testing.
PORT=4310
# HOST=0.0.0.0
# NODE_ENV=production
# Persistent directory for the SQLite file and uploads (Render disk mount).
# DATA_DIR=/var/data
# Full path to the database file. Overrides DATA_DIR for the file only.
# DB_PATH=/var/data/riders-plus.db
# DB_FILE is an alias of DB_PATH (the API tests use it).
# DB_FILE=./data/riders-plus.db
# Admin account. Required in production. Used when the admin user is created,
# and applied again on later seeds if you change the password.
# ADMIN_EMAIL=you@example.com
# ADMIN_PASSWORD=choose-a-long-password
# STRIPE_SECRET_KEY=sk_live_or_test_...       # switches checkout from TEST MODE to Stripe Checkout
# STRIPE_WEBHOOK_SECRET=whsec_...             # needed before enabling real payments (see README)
